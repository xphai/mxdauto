{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.schemas.maple-automation.local/frame-pixel-artifact.schema.json",
  "title": "Maple Automation Core Frame Pixel Artifact",
  "description": "Strict metadata for a content-addressed packed BGR8 frame. The pixel digest and encoded-container hash are separate identities.",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pixelSpec": {
      "type": "object",
      "required": [
        "width",
        "height",
        "channels",
        "pixel_format",
        "dtype",
        "stride",
        "length"
      ],
      "properties": {
        "width": {"type": "integer", "exclusiveMinimum": 0},
        "height": {"type": "integer", "exclusiveMinimum": 0},
        "channels": {"const": 3},
        "pixel_format": {"const": "BGR8"},
        "dtype": {"const": "uint8"},
        "stride": {"type": "integer", "exclusiveMinimum": 0},
        "length": {"type": "integer", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "portableToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^/]+/[^/]+$"
    }
  },
  "required": [
    "schema_version",
    "pixel_digest",
    "ref",
    "image_ref",
    "encoded_sha256",
    "encoded_size",
    "source_encoded_sha256",
    "source_encoded_size",
    "storage_encoding",
    "spec",
    "byte_length",
    "path",
    "privacy_class",
    "retention_class",
    "source_provenance_id",
    "session_id",
    "source_sequence",
    "parent_pixel_digest",
    "transform_version",
    "calibration_sha256"
    ,"artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "pixel_digest": {"$ref": "#/$defs/sha256"},
    "ref": {
      "type": "string",
      "pattern": "^cas://sha256/[a-f0-9]{64}$"
    },
    "image_ref": {
      "type": "string",
      "pattern": "^cas://sha256/[a-f0-9]{64}$"
    },
    "encoded_sha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "encoded_size": {"type": "integer", "exclusiveMinimum": 0},
    "source_encoded_sha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "source_encoded_size": {
      "anyOf": [
        {"type": "integer", "exclusiveMinimum": 0},
        {"type": "null"}
      ]
    },
    "storage_encoding": {"const": "raw"},
    "spec": {"$ref": "#/$defs/pixelSpec"},
    "byte_length": {"type": "integer", "exclusiveMinimum": 0},
    "path": {"$ref": "#/$defs/portablePath"},
    "privacy_class": {
      "enum": ["private", "restricted", "deidentified_public", "hash_only"]
    },
    "retention_class": {
      "enum": ["ephemeral", "candidate", "persistent"]
    },
    "source_provenance_id": {"$ref": "#/$defs/portableToken"},
    "session_id": {"$ref": "#/$defs/portableToken"},
    "source_sequence": {"type": "integer", "minimum": 0},
    "parent_pixel_digest": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "transform_version": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "calibration_sha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "artifact_sha256": {"$ref": "#/$defs/sha256"}
  },
  "oneOf": [
    {
      "properties": {
        "parent_pixel_digest": {"type": "null"},
        "transform_version": {"type": "null"},
        "calibration_sha256": {"type": "null"}
      }
    },
    {
      "properties": {
        "parent_pixel_digest": {"$ref": "#/$defs/sha256"},
        "transform_version": {"type": "string", "minLength": 1},
        "calibration_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  ],
  "additionalProperties": false
}
