{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.schemas.maple-automation.local/player-marker-replay-report.schema.json",
  "title": "Maple Automation Core G1-LOC-003B Player Marker Replay Report",
  "description": "Hash-only deterministic three-run replay evidence. This report is bound to frame ingestion only and does not claim marker accuracy.",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "fault": {
      "type": "string",
      "enum": [
        "admission_missing",
        "ambiguous_packet",
        "candidate_lineage_mismatch",
        "clock_domain_mismatch",
        "calibration_mismatch",
        "config_invalid",
        "detector_fault",
        "duplicate",
        "execution_invalid",
        "extraction_error",
        "extractor_error",
        "extractor_missing",
        "extractor_result_invalid",
        "frame_type",
        "frame_size_changed",
        "geometry_mismatch",
        "image_ref_mismatch",
        "no_frame",
        "out_of_order",
        "packet_lineage_mismatch",
        "pixel_hash_mismatch",
        "pixel_missing",
        "pixel_unavailable",
        "pixel_spec_mismatch",
        "roi_unconfigured",
        "session_mismatch",
        "source_error",
        "source_mismatch",
        "stale",
        "suppressed",
        "timestamp_mismatch",
        "timestamp_regression",
        "transform_mismatch",
        "truth_invalid"
      ]
    },
    "sample": {
      "type": "object",
      "required": [
        "sample_id",
        "status",
        "candidate_digest",
        "evidence_digest",
        "result_digest",
        "detector_result_digest",
        "detector_state_digest",
        "detector_config_digest",
        "exception_type_digest",
        "fault",
        "invoked",
        "as_of_offset_ns",
        "as_of_ns",
        "effective_now_ns",
        "observed_at_ns",
        "generation"
      ],
      "properties": {
        "sample_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["detected", "no_marker", "rejected", "fault"]},
        "candidate_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "evidence_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "result_digest": {"$ref": "#/$defs/sha256"},
        "detector_result_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "detector_state_digest": {"$ref": "#/$defs/sha256"},
        "detector_config_digest": {"$ref": "#/$defs/sha256"},
        "exception_type_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "fault": {"anyOf": [{"$ref": "#/$defs/fault"}, {"type": "null"}]},
        "invoked": {"type": "boolean"},
        "as_of_offset_ns": {
          "type": "integer",
          "minimum": 0,
          "description": "Per-packet detector-now offset added to observed_at_ns."
        },
        "as_of_ns": {
          "type": "integer",
          "minimum": 0,
          "description": "Compatibility alias for as_of_offset_ns."
        },
        "effective_now_ns": {
          "anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}],
          "description": "observed_at_ns plus as_of_offset_ns; null for pre-detector rejections."
        },
        "observed_at_ns": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "generation": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"observed_at_ns": {"type": "integer"}}},
          "then": {"properties": {"effective_now_ns": {"type": "integer"}}}
        },
        {
          "if": {"properties": {"observed_at_ns": {"type": "null"}}},
          "then": {"properties": {"effective_now_ns": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["run_index", "sample_order_digest", "samples", "run_digest"],
      "properties": {
        "run_index": {"type": "integer", "minimum": 1, "maximum": 3},
        "sample_order_digest": {"$ref": "#/$defs/sha256"},
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sample"}
        },
        "run_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "zeroInputAudit": {
      "type": "object",
      "required": [
        "core_v2_real_input_call_count",
        "double_write_event_count",
        "failure_count",
        "input_owner",
        "keyboard_call_count",
        "mouse_call_count",
        "real_input_call_count",
        "real_input_enabled",
        "receiver_connect_count",
        "report_digest",
        "report_type",
        "schema_version",
        "source_commit",
        "status",
        "wheel_sha256",
        "window_write_count"
      ],
      "properties": {
        "core_v2_real_input_call_count": {"const": 0},
        "double_write_event_count": {"const": 0},
        "failure_count": {"const": 0},
        "input_owner": {"const": "legacy"},
        "keyboard_call_count": {"const": 0},
        "mouse_call_count": {"const": 0},
        "real_input_call_count": {"const": 0},
        "real_input_enabled": {"const": false},
        "receiver_connect_count": {"const": 0},
        "report_digest": {"$ref": "#/$defs/sha256"},
        "report_type": {"const": "b2_zero_input_audit"},
        "schema_version": {"const": "1.0.0"},
        "source_commit": {"$ref": "#/$defs/gitCommit"},
        "status": {"const": "PASS"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "window_write_count": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "report_id",
    "scope",
    "truth_scope",
    "verification_profile",
    "corpus_source_commit",
    "replay_source_commit",
    "manifest_digest",
    "corpus_digest",
    "extractor_artifact_digest",
    "extractor_config_digest",
    "as_of_offset_ns",
    "as_of_ns",
    "generation",
    "timing_strategy",
    "sample_order_digest",
    "sample_count",
    "repeat_count",
    "deterministic",
    "execution_valid",
    "status",
    "event_tape_digest",
    "accepted_ledger_digest",
    "calibration_artifact_digest",
    "zero_input_audit_artifact_digest",
    "zero_input_audit",
    "execution_faults",
    "limitations",
    "runs",
    "report_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_type": {"const": "player_marker_replay"},
    "report_id": {"$ref": "#/$defs/id"},
    "scope": {"const": "G1-LOC-003B"},
    "truth_scope": {"const": "frame_ingestion_only"},
    "verification_profile": {"enum": ["b2_gate", "contract_fixture"]},
    "corpus_source_commit": {"$ref": "#/$defs/gitCommit"},
    "replay_source_commit": {"$ref": "#/$defs/gitCommit"},
    "manifest_digest": {"$ref": "#/$defs/sha256"},
    "corpus_digest": {"$ref": "#/$defs/sha256"},
    "extractor_artifact_digest": {"$ref": "#/$defs/sha256"},
    "extractor_config_digest": {"$ref": "#/$defs/sha256"},
    "as_of_offset_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Per-packet detector-now offset added to observed_at_ns."
    },
    "as_of_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Compatibility alias for as_of_offset_ns."
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "description": "Deterministic detector generation bound to every sample."
    },
    "timing_strategy": {
      "const": "observed_at_ns=ledger_received_at_ns_or_ledger_admitted_at_ns_or_event_recorded_at_ns;effective_now_ns=observed_at_ns+as_of_offset_ns;as_of_ns_alias=as_of_offset_ns"
    },
    "sample_order_digest": {"$ref": "#/$defs/sha256"},
    "sample_count": {"type": "integer", "minimum": 1},
    "repeat_count": {"const": 3},
    "deterministic": {"type": "boolean"},
    "execution_valid": {"type": "boolean"},
    "status": {"enum": ["PASS", "FAIL"]},
    "event_tape_digest": {"$ref": "#/$defs/sha256"},
    "event_tape_index_artifact_digest": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}],
      "description": "Raw canonical event-tape index artifact SHA-256; optional for contract_fixture."
    },
    "accepted_ledger_digest": {"$ref": "#/$defs/sha256"},
    "calibration_artifact_digest": {"$ref": "#/$defs/sha256"},
    "zero_input_audit_artifact_digest": {"$ref": "#/$defs/sha256"},
    "zero_input_audit": {"$ref": "#/$defs/zeroInputAudit"},
    "execution_faults": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fault"}
    },
    "limitations": {
      "const": [
        "truth_scope is frame_ingestion_only; no marker accuracy claim is made.",
        "Replay compares detector contract outputs only; it does not establish marker accuracy.",
        "Raw pixels, host paths, and identity mappings are excluded from this report."
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/run"}
    },
    "report_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verification_profile": {"const": "b2_gate"}},
        "required": ["verification_profile"]
      },
      "then": {
        "required": ["event_tape_index_artifact_digest"],
        "properties": {
          "event_tape_index_artifact_digest": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {
        "properties": {"deterministic": {"const": true}, "execution_valid": {"const": true}},
        "required": ["deterministic", "execution_valid"]
      },
      "then": {"properties": {"status": {"const": "PASS"}}}
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"deterministic": {"const": false}}},
          {"properties": {"execution_valid": {"const": false}}}
        ]
      },
      "then": {"properties": {"status": {"const": "FAIL"}}}
    }
  ],
  "additionalProperties": false
}
