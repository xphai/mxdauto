{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.schemas.maple-automation.local/player-marker-replay-report.schema.json",
  "title": "Maple Automation Core G1-LOC-003B Player Marker Replay Report",
  "description": "Hash-only deterministic three-run replay evidence. This report is bound to frame ingestion only and does not claim marker accuracy.",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "fault": {
      "type": ["string", "null"],
      "enum": [
        null,
        "admission_missing",
        "ambiguous_packet",
        "candidate_lineage_mismatch",
        "clock_domain_mismatch",
        "duplicate",
        "extractor_error",
        "extractor_missing",
        "extractor_result_invalid",
        "frame_size_changed",
        "no_frame",
        "out_of_order",
        "pixel_unavailable",
        "packet_lineage_mismatch",
        "session_mismatch",
        "source_error",
        "source_mismatch",
        "stale",
        "suppressed",
        "timestamp_regression",
        "truth_invalid"
      ]
    },
    "sample": {
      "type": "object",
      "required": [
        "sample_id",
        "status",
        "candidate_digest",
        "evidence_digest",
        "result_digest",
        "fault"
      ],
      "properties": {
        "sample_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["detected", "no_marker", "rejected", "fault"]},
        "candidate_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "evidence_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "result_digest": {"$ref": "#/$defs/sha256"},
        "fault": {"$ref": "#/$defs/fault"}
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["run_index", "sample_order_digest", "samples", "run_digest"],
      "properties": {
        "run_index": {"type": "integer", "minimum": 1, "maximum": 3},
        "sample_order_digest": {"$ref": "#/$defs/sha256"},
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sample"}
        },
        "run_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "zeroInputAudit": {
      "type": "object",
      "required": [
        "input_owner",
        "real_input_enabled",
        "real_input_call_count",
        "core_v2_real_input_call_count",
        "receiver_connect_count",
        "window_write_count",
        "double_write_event_count",
        "keyboard_call_count",
        "mouse_call_count"
      ],
      "properties": {
        "input_owner": {"const": "legacy"},
        "real_input_enabled": {"const": false},
        "real_input_call_count": {"const": 0},
        "core_v2_real_input_call_count": {"const": 0},
        "receiver_connect_count": {"const": 0},
        "window_write_count": {"const": 0},
        "double_write_event_count": {"const": 0},
        "keyboard_call_count": {"const": 0},
        "mouse_call_count": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "report_id",
    "scope",
    "truth_scope",
    "source_commit",
    "manifest_digest",
    "corpus_digest",
    "config_digest",
    "as_of_ns",
    "sample_order_digest",
    "sample_count",
    "repeat_count",
    "deterministic",
    "status",
    "event_tape_digest",
    "zero_input_audit",
    "limitations",
    "runs",
    "report_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_type": {"const": "player_marker_replay"},
    "report_id": {"$ref": "#/$defs/id"},
    "scope": {"const": "G1-LOC-003B"},
    "truth_scope": {"const": "frame_ingestion_only"},
    "source_commit": {"$ref": "#/$defs/gitCommit"},
    "manifest_digest": {"$ref": "#/$defs/sha256"},
    "corpus_digest": {"$ref": "#/$defs/sha256"},
    "config_digest": {"$ref": "#/$defs/sha256"},
    "as_of_ns": {"type": "integer", "minimum": 0},
    "sample_order_digest": {"$ref": "#/$defs/sha256"},
    "sample_count": {"type": "integer", "minimum": 1},
    "repeat_count": {"const": 3},
    "deterministic": {"type": "boolean"},
    "status": {"enum": ["PASS", "FAIL"]},
    "event_tape_digest": {"$ref": "#/$defs/sha256"},
    "zero_input_audit": {"$ref": "#/$defs/zeroInputAudit"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "runs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/run"}
    },
    "report_digest": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false
}
