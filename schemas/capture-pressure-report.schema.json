{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.schemas.maple-automation.local/capture-pressure-report.schema.json",
  "title": "Maple Automation Core Raw Latest Slot Pressure Report",
  "description": "Strict offline evidence for the Core-owned capacity-one raw latest slot. The report does not describe an upstream device or driver queue.",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "portableToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "nonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInt": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "failureList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "schedule_version",
        "seed",
        "publish_take_operations",
        "lifecycle_races",
        "repetitions",
        "timeout_s",
        "enforce_minimums"
      ],
      "properties": {
        "schedule_version": {
          "const": "capture-pressure-v1"
        },
        "seed": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "publish_take_operations": {
          "$ref": "#/$defs/positiveInt"
        },
        "lifecycle_races": {
          "$ref": "#/$defs/positiveInt"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 3
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "enforce_minimums": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "required": [
        "minimum_publish_take_operations",
        "minimum_lifecycle_races",
        "publish_take_operations",
        "lifecycle_races",
        "minimums_met",
        "evidence_complete",
        "coverage"
      ],
      "properties": {
        "minimum_publish_take_operations": {
          "const": 100000
        },
        "minimum_lifecycle_races": {
          "const": 1000
        },
        "publish_take_operations": {
          "$ref": "#/$defs/positiveInt"
        },
        "lifecycle_races": {
          "$ref": "#/$defs/positiveInt"
        },
        "minimums_met": {
          "type": "boolean"
        },
        "evidence_complete": {
          "type": "boolean"
        },
        "coverage": {
          "enum": [
            "FULL",
            "SMOKE"
          ]
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "runtime",
        "execution_mode",
        "hardware_used",
        "network_used",
        "python_version",
        "platform",
        "dependency_lock_sha256",
        "wheel_sha256"
      ],
      "properties": {
        "runtime": {
          "const": "python"
        },
        "execution_mode": {
          "const": "offline"
        },
        "hardware_used": {
          "const": false
        },
        "network_used": {
          "const": false
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "wheel_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "schedules": {
      "type": "object",
      "required": [
        "schedule_version",
        "seed",
        "repeat_count",
        "barrier_controlled"
      ],
      "properties": {
        "schedule_version": {
          "const": "capture-pressure-v1"
        },
        "seed": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 3
        },
        "barrier_controlled": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "counterEpochs": {
      "type": "object",
      "required": [
        "lightweight_epoch_count",
        "lifecycle_epoch_count",
        "equation_holds",
        "pending_binary",
        "max_depth",
        "scope",
        "in_flight_binary"
      ],
      "properties": {
        "lightweight_epoch_count": {
          "$ref": "#/$defs/positiveInt"
        },
        "lifecycle_epoch_count": {
          "$ref": "#/$defs/positiveInt"
        },
        "equation_holds": {
          "type": "boolean"
        },
        "pending_binary": {
          "type": "boolean"
        },
        "max_depth": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "scope": {
          "const": "core_owned_raw_latest"
        },
        "in_flight_binary": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "timeouts": {
      "type": "object",
      "required": [
        "race_timeout_s",
        "deadlocks",
        "threads_left_alive",
        "all_threads_exit"
      ],
      "properties": {
        "race_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "deadlocks": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "threads_left_alive": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "all_threads_exit": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": [
        "scope",
        "measurement",
        "bucket_bytes",
        "threshold_bytes",
        "tracemalloc",
        "rss",
        "evidence_complete",
        "linear_growth_observed",
        "passed"
      ],
      "properties": {
        "scope": {
          "const": "core_owned_raw_latest"
        },
        "measurement": {
          "const": "tracemalloc_and_process_rss"
        },
        "bucket_bytes": {
          "const": 1048576
        },
        "threshold_bytes": {
          "const": 67108864
        },
        "tracemalloc": {
          "$ref": "#/$defs/memoryMetric"
        },
        "rss": {
          "$ref": "#/$defs/memoryMetric"
        },
        "evidence_complete": {
          "type": "boolean"
        },
        "linear_growth_observed": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "memoryMetric": {
      "type": "object",
      "required": [
        "relative_to_before",
        "available",
        "before_bytes",
        "mid_bytes",
        "after_bytes",
        "peak_bytes",
        "growth_bytes",
        "threshold_bytes",
        "linear_growth_observed",
        "within_threshold"
