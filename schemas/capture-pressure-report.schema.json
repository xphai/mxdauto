        "mid_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "after_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "peak_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "growth_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "threshold_bytes": {
          "const": 67108864
        },
        "linear_growth_observed": {
          "type": "boolean"
        },
        "within_threshold": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "pixelCas": {
      "type": "object",
      "required": [
        "fixture",
        "width",
        "height",
        "channels",
        "byte_length",
        "pixel_digest",
        "expected_zero_digest",
        "copy_verified",
        "hash_verified",
        "cas_put_get_verified",
        "cas_ref",
        "failures",
        "status"
      ],
      "properties": {
        "fixture": {
          "const": "full_size_zero_bgr8_v1"
        },
        "width": {
          "const": 1920
        },
        "height": {
          "const": 1080
        },
        "channels": {
          "const": 3
        },
        "byte_length": {
          "const": 6220800
        },
        "pixel_digest": {
          "$ref": "#/$defs/sha256"
        },
        "expected_zero_digest": {
          "$ref": "#/$defs/sha256"
        },
        "copy_verified": {
          "type": "boolean"
        },
        "hash_verified": {
          "type": "boolean"
        },
        "cas_put_get_verified": {
          "type": "boolean"
        },
        "cas_ref": {
          "type": "string",
          "pattern": "^cas://sha256/[A-Fa-f0-9]{64}$"
        },
        "failures": {
          "$ref": "#/$defs/failureList"
        },
        "status": {
          "const": "PASS"
        }
      },
      "additionalProperties": false
    },
